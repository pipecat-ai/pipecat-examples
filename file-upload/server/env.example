# file-upload - Environment Variables
# Copy this file to .env and fill in your API keys

PIPECAT_UPLOADS_FOLDER=/tmp/pipecat-uploads

# Cloud-bucket upload storage (only for the storage-backend variants)
# bot_gcs.py: bucket name; auth via Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS or `gcloud auth application-default login`)
# GCS_UPLOADS_BUCKET=
# bot_s3.py: bucket name; auth via the AWS_* variables below
# S3_UPLOADS_BUCKET=

# Daily (Transport)
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=



# Cartesia (STT/TTS)
CARTESIA_API_KEY=
# Optional: Defaults to "71a7ad14-091c-4e8e-a314-022ece01c121"
# CARTESIA_VOICE_ID= 

# Deepgram (STT/TTS)
DEEPGRAM_API_KEY=


# LLM (select provider with `uv run bot.py -llm <anthropic|openai|bedrock|gemini>`; default: anthropic)

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI
OPENAI_API_KEY=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Google Gemini
GOOGLE_API_KEY=

