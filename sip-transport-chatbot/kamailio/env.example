# Bot SIP account. AOR is sip:SIP_USER@SIP_DOMAIN; REGISTERs go to
# KAMAILIO_REGISTRAR, which is often a different host than SIP_DOMAIN.
SIP_USER=5001
SIP_DOMAIN=kamailio.lab
# Unused with the bundled lab config (no auth); set a real one when you
# add digest auth to kamailio.cfg.
SIP_PASSWORD=bot-password
SIP_TRANSPORT=udp

# Where REGISTERs are sent, host:port. Empty = register at SIP_DOMAIN.
KAMAILIO_REGISTRAR=192.0.2.10:5060
