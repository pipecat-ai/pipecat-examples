# Where the client starts a bot session. The Next.js API routes forward
# requests here so the Pipecat Cloud key never reaches the browser.
#
# Local development (uv run bot.py in ../server):
BOT_START_URL="http://localhost:7860/start"
BOT_START_PUBLIC_API_KEY=""

# Pipecat Cloud (replace {agentName} with the agent_name from pcc-deploy.toml):
# BOT_START_URL="https://api.pipecat.daily.co/v1/public/{agentName}/start"
# BOT_START_PUBLIC_API_KEY="your-pipecat-cloud-public-api-key"

# Used for Open Graph metadata
SITE_URL="http://localhost:3000"
