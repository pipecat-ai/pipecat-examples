DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Bot configuration (bot.py), read however the host is started.
# MOQ_VOICE_LLM_MODEL=gpt-4o
# MOQ_VOICE_TTS_VOICE=71a7ad14-091c-4e8e-a314-022ece01c121
# MOQ_VOICE_SYSTEM_PROMPT=You are a helpful assistant in a real-time voice call.
# MOQ_SESSION_IDLE_SECS=300   # end a call with no speech; 0 disables

# Host configuration (server.py). Each is the default for the matching CLI
# flag, and the flag wins; see `uv run server.py --help`.
#
# The three marked (client) are also inlined into the browser client at build
# time, so it defaults to the same relay this host dials. Nothing else in this
# file reaches the browser.
MOQ_RELAY_URL=http://localhost:4443   # (client)
# MOQ_REQUEST_PREFIX=request          # (client)
# MOQ_RESPONSE_PREFIX=response        # (client)
# MOQ_TLS_INSECURE=1
# MOQ_MAX_SESSIONS=8
# MOQ_PEER_WAIT_SECS=60
# MOQ_HOST_IDLE_SECS=0        # 0 runs until stopped
