# Copy this file to .env and fill in the values. .env is gitignored.
# One file only: the bot reads server/.env if that file exists, otherwise this one.
# Keep unused lines commented out; an empty VAR= line overrides a key exported in the shell.

# Gradium: speech-to-text, text-to-speech, and voice design (https://gradium.ai)
GRADIUM_API_KEY=

# The LLM the bot thinks with. Uncomment the one for LLM_PROVIDER in server/bot.py:
#   openai     https://platform.openai.com/api-keys
#   gemini     https://aistudio.google.com/apikey
#   anthropic  https://console.anthropic.com/settings/keys
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: another model from the same provider (default: the small, low-latency one in bot.py)
# LLM_MODEL=
