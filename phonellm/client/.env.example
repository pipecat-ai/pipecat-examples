# ---------------------------------------------------------------------------
# Client (VITE_* — inlined into the bundle at build time, so never secret)
# ---------------------------------------------------------------------------

# Which transport to connect with: smallwebrtc | daily. Defaults to
# smallwebrtc in dev and daily in a production build. Set it to force one —
# e.g. daily, to exercise the Pipecat Cloud path locally under `vercel dev`.
# VITE_TRANSPORT=daily

# smallwebrtc only. The bot's WebRTC offer endpoint. Defaults to /api/offer,
# which the Vite dev server proxies to the bot on port 7860. Set an absolute
# URL for a build served away from the bot.
# VITE_OFFER_URL=https://bot.example.com/api/offer

# daily only. The endpoint that starts a Pipecat Cloud session; defaults to
# /api/connect, served by api/connect.ts in the same deployment.
# VITE_CONNECT_URL=/api/connect

# ---------------------------------------------------------------------------
# Server (api/connect.ts — no VITE_ prefix, so these stay out of the bundle)
# ---------------------------------------------------------------------------

# Full start endpoint for the deployed agent. On Pipecat Cloud that is
# https://api.pipecat.daily.co/v1/public/<agent-name>/start — the agent name
# is the one in `pipecat cloud agent list` (the scaffold deploys as
# phonellm-example).
BOT_START_URL=https://api.pipecat.daily.co/v1/public/phonellm-example/start

# Pipecat Cloud public API key, from `pipecat cloud organizations keys`.
# Secret: set it in the Vercel project's environment variables, not here.
BOT_START_PUBLIC_KEY=pk_
