# phonellm-example - Environment Variables
# Copy this file to .env and fill in your keys

# Service selection
# LLM_SERVICE: phonellm (default) | openai
# LLM_SERVICE=phonellm
# TTS_SERVICE: deepgram (default) | cartesia
# TTS_SERVICE=deepgram

# PhoneLLM on Modal — required when LLM_SERVICE=phonellm
# Endpoint URL printed by `modal endpoint create` (or from the Modal dashboard —
# the CLI can't retrieve it after creation)
MODAL_ENDPOINT_URL=
# Proxy token from `modal workspace proxy-tokens create`,
# combined as <token-id>.<token-secret> (wk-....ws-...)
MODAL_API_KEY=

# OpenAI (LLM) — required when LLM_SERVICE=openai
# OPENAI_API_KEY=
# Optional: model to use (default: gpt-4.1)
# OPENAI_MODEL=gpt-4.1

# Deepgram — Flux STT is always used; Flux TTS when TTS_SERVICE=deepgram
DEEPGRAM_API_KEY=

# Cartesia (TTS) — required when TTS_SERVICE=cartesia
# CARTESIA_API_KEY=

# Optional: voice for the selected TTS service
# Deepgram Flux default: flux-heather-en
# Cartesia default: 86e30c1d-714b-4074-a1f2-1cb6b552fb49
# TTS_VOICE=flux-heather-en

# Daily (Transport) — only needed when running with `-t daily`
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=
